# Copy to .env.local and fill in. Never commit real values.
# Every service is optional: without keys the app runs guest-only with the scripted demo tutor,
# an in-memory KV store and (in `next dev`) a local PGlite database in .data/pglite.

# --- Database (Neon) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=

# --- LLM + embeddings ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# Model fallback chain, best first: if a model fails (down, rate limited, retired) the next one answers.
# Comma separated (model ids contain "/"). Classifier models (llama-prompt-guard) can't chat and are skipped.
MODEL_CHAIN=

# --- Storage / cache ---
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Secrets for internal routes ---
ANON_COOKIE_SECRET=
CRON_SECRET=
INTERNAL_JOB_SECRET=

# --- Feature flags (true/false) ---
ENABLE_OCR=
ENABLE_PROMPT_GUARD=
ENABLE_DEV_PAGES=

# --- Limits ---
UPLOAD_QUOTA_PER_WEEK=
MAX_ACTIVE_DOCUMENTS=
MAX_PDF_SIZE_MB=
MAX_PDF_PAGES=
RETAIN_PDF=
GUEST_MAX_TURNS_PER_THREAD=
GUEST_MAX_THREADS_PER_DAY=
USER_MAX_MESSAGES_PER_DAY=

# --- Local / test infrastructure (never set these on Vercel) ---
PGLITE_DIR=
LLM_MODE=
MOCK_LLM_DELAY_MS=
E2E_TEST_AUTH=

# --- App ---
NEXT_PUBLIC_APP_URL=
